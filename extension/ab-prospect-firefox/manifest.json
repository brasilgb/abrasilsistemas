{
  "manifest_version": 3,
  "name": "AB Prospect — Google Maps e CRM",
  "version": "1.1.0",
  "description": "Captura assistida de empresas no Google Maps, classifica presença digital e envia prospects ao CRM da AB Sistemas.",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "AB Prospect",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ab-prospect@abrasilsistemas.com.br",
      "strict_min_version": "128.0"
    }
  }
}
