APP_NAME="AB Sistemas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://abrasilsistemas.com.br

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ande3377_absistemas
DB_USERNAME=abrasilsistema_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.titan.email
MAIL_PORT=465
MAIL_USERNAME=contato@abrasilsistemas.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contato@abrasilsistemas.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MP_ACCESS_TOKEN=
MP_WEBHOOK_TOKEN=

# Token das rotas legadas /api/prospects/* e /api/whatsapp/messages/* (extensão AB Prospect e
# workflows do n8n). Fica até essas integrações apontarem para o VetorLeads (ABRASIL-WEB-03).
AB_PROSPECT_API_TOKEN=

CONTACT_WHATSAPP_NUMBER=5551998931325
CONTACT_WHATSAPP_DISPLAY="(51) 99893-1325"
CONTACT_EMAIL=contato@abrasilsistemas.com.br

# WAHA compartilhado (infra-abrasil). Atendimento WhatsApp: a chave HMAC precisa ser a mesma
# configurada em "hmac.key" no webhook da sessão; vazia = recebimento desligado.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_KEY=

# Copie a chave pública em VetorLeads → Configurações → Canais → Chat do Site.
VETORCHAT_WIDGET_KEY=
VETORCHAT_SCRIPT_URL=https://vetorleads.com.br/widget.js

# SEO (Painel → SEO). Homologação: true bloqueia a indexação (robots Disallow: / e noindex).
SEO_BLOCK_INDEXING=false
# Endereço interno que a auditoria de SEO acessa (ex.: http://nginx). Vazio = domínio canônico.
SEO_AUDIT_BASE_URL=
# OAuth do Google (Search Console + GA4 Data API, só leitura). URI de retorno:
# https://SEU-DOMINIO/admin/seo/integracoes/google/callback
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
